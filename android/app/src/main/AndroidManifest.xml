<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Le jeu tourne hors-ligne (asset local). INTERNET sert uniquement à la
         vérification de mise à jour et au téléchargement de l'APK. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Mise à jour in-app : installer l'APK téléchargé via l'installeur système. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- ⚠ `android:appCategory="game"` n'est PAS une métadonnée décorative : en targetSdk 36,
         orientation, redimensionnement et ratio cessent d'être respectés sur les écrans
         >= sw600dp — SAUF pour les applications déclarées comme JEUX. C'est la seule exception
         PÉRENNE (la propriété PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY, elle, est temporaire
         et tombera en API 37). `screenOrientation="portrait"` continue donc de tenir sur tablette. -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:label="${appLabel}"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Archipel"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
